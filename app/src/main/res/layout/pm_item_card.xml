<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="136dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp" android:background="@drawable/pm_card" android:elevation="1dp">
