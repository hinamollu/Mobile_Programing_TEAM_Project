<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/placementRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_background"
    android:orientation="vertical">

    <!-- 상단 바 (프로젝트 화면과 같은 모양) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/pm_card"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/placementBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/pm_back"
            android:padding="12dp"
            android:src="@drawable/pm_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/placementTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pm_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/placementSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/pm_teal"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 충돌 경고 배너: 충돌이 없으면 숨김 -->
    <TextView
        android:id="@+id/placementWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3C4"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:textColor="#7A4B00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 2D 격자 -->
    <com.mobileprograming.teamproject.feature.placement.PlacementView
        android:id="@+id/placementView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 선택된 가구 정보 + 회전 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pm_card"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/placementInfoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/pm_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/placementInfoDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minLines="2"
                android:textColor="@color/pm_teal"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/placementRotate"
            style="@style/pm_CompactButton"
            android:layout_width="96dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/pm_primary_background"
            android:text="90° 회전"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
