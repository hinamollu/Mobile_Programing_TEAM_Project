<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pm_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:paddingHorizontal="8dp" android:gravity="center_vertical" android:background="@color/pm_card" android:elevation="2dp">
<ImageButton android:id="@+id/pm_back" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/pm_back" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/pm_back"/>
<TextView android:id="@+id/pm_title" android:maxLines="1" android:ellipsize="end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:paddingHorizontal="8dp" android:textColor="@color/pm_ink" android:textSize="20sp" android:textStyle="bold"/>
<ImageButton android:id="@+id/pm_share" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/pm_share" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/pm_share"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<androidx.recyclerview.widget.RecyclerView android:id="@+id/pm_list" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:paddingBottom="88dp" android:clipToPadding="false"/>
<com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/pm_add" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="20dp" android:src="@drawable/pm_plus" app:tint="#FFFFFF" app:backgroundTint="@color/pm_teal" app:fabSize="normal" app:shapeAppearanceOverlay="@style/pm_RoundFab"/>
</FrameLayout></LinearLayout>